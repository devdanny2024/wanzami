aws_region = "eu-north-1"

vpc_id = "vpc-057d9f5b5e1dc1f57"
public_subnets = [
  "subnet-0dd351dff9755e591",
  "subnet-0ad34b67f04ebba46",
]
private_subnets = [
  "subnet-09cb4e00742acb469",
  "subnet-06aa0f23b008bddab",
]

alb_sg_id = "sg-019f6b04a49296260"
ecs_sg_id = "sg-0f550f0702b1dd9a0"

# IAM role names you created earlier
ecs_execution_role_name = "ecsTaskExecutionRole"
ecs_task_role_name      = "ecsTaskRole"

# Optional: API domain + Route53 zone
api_domain = ""
api_zone_id = ""

# Optional: media bucket + CloudFront
# Setting this grants the ECS task role GetObject/PutObject access to the bucket.
media_bucket_name = "wanzami-media-eu-576393818319"

# Application environment variables (DO NOT COMMIT SECRETS)
# Copy this file to terraform.tfvars and fill in values securely.

env_vars = {
  APP_ORIGIN            = "https://www.wanzami.tv"
  ADMIN_APP_ORIGIN      = "https://wanzami-admin.vercel.app"
  PORT                  = "4000"
  AWS_REGION            = "eu-north-1"
  AWS_DEFAULT_REGION    = "eu-north-1"

  # IVS must be created in a supported region (separate from the ECS region)
  IVS_REGION            = "eu-west-1"

  # Do NOT hard-code DATABASE_URL here for production ECS.
  # When existing_db_instance_identifier is set, Terraform now injects:
  # - DB_HOST / DB_PORT / DB_NAME as plain env vars
  # - DB_USER / DB_PASSWORD from the live RDS master secret at task start
  DB_NAME               = "wanzami"

  # Media bucket (new account / eu-north-1)
  # Do not set static S3 creds for ECS; let the task role access this bucket.
  S3_BUCKET             = "wanzami-media-eu-576393818319"
  S3_REGION             = "eu-north-1"
  MEDIA_CDN_BASE        = "https://d2gnxyreh5ighz.cloudfront.net"

  # Google OAuth (required for /api/auth/google/*)
  GOOGLE_CLIENT_ID      = "REPLACE_ME"
  GOOGLE_CLIENT_SECRET  = "REPLACE_ME"
  GOOGLE_REDIRECT_URI   = "https://www.wanzami.tv/oauth/google/callback"

  # Secrets placeholders
  FLW_PUBLIC_KEY        = "REPLACE_ME"
  FLW_SECRET_KEY        = "REPLACE_ME"
  FLW_ENCRYPTION_KEY    = "REPLACE_ME"
  FLW_WEBHOOK_SECRET    = "REPLACE_ME"
  PAYSTACK_PUBLIC_KEY   = "REPLACE_ME"
  PAYSTACK_SECRET_KEY   = "REPLACE_ME"
  PAYSTACK_CALLBACK_URL = "https://wanzami.tv/ppv/success"
  PAYSTACK_WEBHOOK_SECRET = "REPLACE_ME"
  JWT_ACCESS_SECRET     = "REPLACE_ME"
  JWT_REFRESH_SECRET    = "REPLACE_ME"
  REDIS_URL             = "REPLACE_ME"
  # Gmail SMTP (App Password)
  SMTP_HOST             = "smtp.gmail.com"
  SMTP_PORT             = "465"
  SMTP_USER             = "your_gmail_address@gmail.com"
  SMTP_PASS             = "REPLACE_ME_GMAIL_APP_PASSWORD"
  SMTP_FROM             = "Wanzami <wanzamitv@gmail.com>"
  DEVICE_LIMIT          = "4"
  PPV_ACCESS_DAYS       = "3"
}
