# Optional: media bucket + CloudFront
media_bucket_name = ""

# Application environment variables (DO NOT COMMIT SECRETS)
# Copy this file to terraform.tfvars and fill in values securely.

env_vars = {
  APP_ORIGIN            = "https://www.wanzami.tv"
  ADMIN_APP_ORIGIN      = "https://wanzami-admin.vercel.app"
  PORT                  = "4000"
  AWS_REGION            = "eu-north-1"
  AWS_DEFAULT_REGION    = "eu-north-1"
  DATABASE_URL          = "postgresql://postgres:REPLACE_ME@database-1.cxy88uogafmp.eu-north-1.rds.amazonaws.com:5432/wanzami"

  # TODO: Replace with EU S3 + CDN if migrating assets
  # Media bucket (new account / eu-north-1)
  S3_BUCKET             = "wanzami-media-eu"
  S3_REGION             = "eu-north-1"
  MEDIA_CDN_BASE        = "https://dylsoq281d2uy.cloudfront.net"

  # Google OAuth (required for /api/auth/google/*)
  GOOGLE_CLIENT_ID      = "REPLACE_ME"
  GOOGLE_CLIENT_SECRET  = "REPLACE_ME"
  GOOGLE_REDIRECT_URI   = "https://www.wanzami.tv/oauth/google/callback"

  # Secrets placeholders
  S3_ACCESS_KEY         = "REPLACE_ME"
  S3_SECRET_KEY         = "REPLACE_ME"
  FLW_PUBLIC_KEY        = "REPLACE_ME"
  FLW_SECRET_KEY        = "REPLACE_ME"
  FLW_ENCRYPTION_KEY    = "REPLACE_ME"
  FLW_WEBHOOK_SECRET    = "REPLACE_ME"
  PAYSTACK_PUBLIC_KEY   = "REPLACE_ME"
  PAYSTACK_SECRET_KEY   = "REPLACE_ME"
  PAYSTACK_CALLBACK_URL = "https://wanzami.tv/ppv/success"
  PAYSTACK_WEBHOOK_SECRET = "REPLACE_ME"
  JWT_ACCESS_SECRET     = "REPLACE_ME"
  JWT_REFRESH_SECRET    = "REPLACE_ME"
  REDIS_URL             = "REPLACE_ME"
  # Gmail SMTP (App Password)
  SMTP_HOST             = "smtp.gmail.com"
  SMTP_PORT             = "465"
  SMTP_USER             = "your_gmail_address@gmail.com"
  SMTP_PASS             = "REPLACE_ME_GMAIL_APP_PASSWORD"
  SMTP_FROM             = "Wanzami <wanzamitv@gmail.com>"
