# ============================================================================
# Wanzami VPS deployment env — copy to deploy/.env and fill the CHANGE_ME values.
# Pull the real secret values from the current ECS task definition (profile new):
#   aws ecs describe-task-definition --task-definition wanzami-backend-task \
#     --query 'taskDefinition.containerDefinitions[0].environment' --profile new
# ============================================================================

# ---- compose-only (used by docker-compose.yml, not the app) ----------------
API_DOMAIN=api.wanzami.tv          # prod domain; or ":80" to test over plain HTTP on a VPS IP
POSTGRES_USER=wanzami
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=wanzami

# ---- core app --------------------------------------------------------------
PORT=4000
NODE_ENV=production
# Points the app at the postgres + redis containers on the compose network:
DATABASE_URL=postgresql://wanzami:CHANGE_ME_strong_db_password@postgres:5432/wanzami
REDIS_URL=redis://redis:6379
REDIS_TLS=false                    # self-hosted redis = no TLS (ElastiCache used TLS)

# ---- auth / sessions -------------------------------------------------------
JWT_ACCESS_SECRET=CHANGE_ME        # copy from ECS task def
JWT_REFRESH_SECRET=CHANGE_ME       # copy from ECS task def
ACCESS_TOKEN_EXPIRES_IN=2h
REFRESH_TOKEN_EXPIRES_IN=365d
DEVICE_LIMIT=4
BOOTSTRAP_SUPER_ADMIN_NAME=CHANGE_ME
BOOTSTRAP_SUPER_ADMIN_EMAIL=CHANGE_ME
BOOTSTRAP_SUPER_ADMIN_PASSWORD=CHANGE_ME

# ---- origins (CORS / redirects) — update to the live frontend/admin URLs ----
APP_ORIGIN=https://wanzami.tv
ADMIN_APP_ORIGIN=https://admin.wanzami.tv
API_PUBLIC_URL=https://api.wanzami.tv

# ---- MEDIA STORAGE = Cloudflare R2 (S3-compatible; replaces AWS S3) ---------
# R2 endpoint = https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto                     # R2 ignores region; "auto" is correct
AWS_REGION=auto
S3_BUCKET=wanzami-media            # the R2 bucket name
S3_ACCESS_KEY=CHANGE_ME_R2_ACCESS_KEY_ID
S3_SECRET_KEY=CHANGE_ME_R2_SECRET_ACCESS_KEY
# Media playback URL base. Set to a Cloudflare-served R2 custom domain to serve
# via CDN; leave BLANK to have the backend return presigned R2 URLs instead.
MEDIA_CDN_BASE=https://media.wanzami.tv

# ---- transcode worker ------------------------------------------------------
FFMPEG_PATH=/usr/bin/ffmpeg        # provided by deploy/Dockerfile (apk add ffmpeg)
TRANSCODE_CONCURRENCY=3            # lower to 1-2 if sharing a small box with the API

# ---- email (external SMTP — unchanged from AWS) ----------------------------
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
SMTP_FROM=Wanzami <no-reply@wanzami.tv>
SUPPORT_EMAIL=support@wanzami.tv

# ---- payments (external — copy live values; UPDATE webhook/callback URLs) ---
PAYSTACK_SECRET_KEY=CHANGE_ME
PAYSTACK_PUBLIC_KEY=CHANGE_ME
PAYSTACK_CALLBACK_URL=https://api.wanzami.tv/api/...   # re-point to new API domain
PAYSTACK_WEBHOOK_SECRET=CHANGE_ME
FLW_PUBLIC_KEY=CHANGE_ME
FLW_SECRET_KEY=CHANGE_ME
FLW_ENCRYPTION_KEY=CHANGE_ME
FLW_BASE_URL=https://api.flutterwave.com
FLW_WEBHOOK_SECRET=CHANGE_ME
FLW_CALLBACK_URL=https://api.wanzami.tv/api/app-session/ppv/flutterwave/return
FLW_APP_SESSION_RETURN_URL=wanzami://ppv/complete
PPV_ACCESS_DAYS=30

# ---- Google OAuth (UPDATE redirect URI in Google Cloud console) ------------
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://wanzami.tv/oauth/google/callback

# ---- live streaming (AWS IVS) — dormant; leave as-is, VOD works without it --
IVS_REGION=us-east-1
IVS_RECORDING_ENABLED=false
# IVS still needs AWS creds IF you ever enable live. For VOD-only, harmless if unset.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
