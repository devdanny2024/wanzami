DATABASE_URL="postgresql://user:password@localhost:5432/wanzami"
PORT=4000
JWT_ACCESS_SECRET="your-access-secret"
JWT_REFRESH_SECRET="your-refresh-secret"
ACCESS_TOKEN_EXPIRES_IN="2h"
REFRESH_TOKEN_EXPIRES_IN="2h"
DEVICE_LIMIT=4
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user"
SMTP_PASS="pass"
SMTP_FROM="Wanzami <no-reply@wanzami.com>"
APP_ORIGIN="http://localhost:3000"
ADMIN_APP_ORIGIN="http://localhost:3001"
API_PUBLIC_URL="http://localhost:4000"

# Redis / BullMQ
REDIS_URL="redis://localhost:6379"
# Set true for managed Redis that requires TLS (or use rediss:// URL)
REDIS_TLS="false"

# Media storage (S3)
S3_BUCKET="wanzami-media-eu-576393818319"
S3_REGION="eu-north-1"
AWS_REGION="eu-north-1"
# Leave S3_ACCESS_KEY / S3_SECRET_KEY unset in ECS so the task role is used.
# For local/dev without IAM role auth, prefer AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY below.
# Optional: set MEDIA_CDN_BASE when serving media behind a CDN.
# If blank, the backend will return presigned S3 URLs.
MEDIA_CDN_BASE="https://d2gnxyreh5ighz.cloudfront.net"
REDIS_CONNECT_TIMEOUT_MS="10000"
REDIS_LAZY_CONNECT="true"
REDIS_RETRY_BASE_DELAY_MS="250"
REDIS_RETRY_MAX_DELAY_MS="5000"
REDIS_MAX_RECONNECT_ATTEMPTS="50"
QUEUE_ENQUEUE_TIMEOUT_MS="2500"
QUEUE_ENQUEUE_MAX_ATTEMPTS="3"
QUEUE_ENQUEUE_RETRY_BASE_DELAY_MS="200"
QUEUE_ENQUEUE_RETRY_MAX_DELAY_MS="2000"

# Payments
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_CALLBACK_URL=""
PAYSTACK_WEBHOOK_SECRET=""
FLW_PUBLIC_KEY=""
FLW_SECRET_KEY=""
FLW_ENCRYPTION_KEY=""
FLW_BASE_URL="https://api.flutterwave.com"
FLW_CALLBACK_URL="http://localhost:4000/api/app-session/ppv/flutterwave/return"
FLW_APP_SESSION_RETURN_URL="wanzami://ppv/complete"
FLW_WEBHOOK_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/oauth/google/callback"

# Live streaming (AWS IVS)
IVS_REGION="us-east-1"
IVS_RECORDING_ENABLED="false"
LIVE_SOURCE_HEARTBEAT_TIMEOUT_MS="45000"
# Optional fallback for local/dev environments not using IAM role-based auth.
# In ECS, leave these unset so the task role is used.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Internal/owner accounts (comma-separated emails): free PPV access on every
# title, excluded from engagement analytics.
INTERNAL_TEST_EMAILS=""
