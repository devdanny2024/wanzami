# Live streaming (AWS IVS)
AWS_REGION="us-east-1"
IVS_REGION="us-east-1"
IVS_RECORDING_ENABLED="false"
LIVE_SOURCE_HEARTBEAT_TIMEOUT_MS="45000"
# Required by AWS SDK in environments not using IAM role-based auth
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
